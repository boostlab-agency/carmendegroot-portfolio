# ─────────────────────────────────────────────────────────────
#  carmendegroot.nl — omgevingsvariabelen
#  Kopieer naar .env.local (lokaal) en zet dezelfde waarden in Vercel.
# ─────────────────────────────────────────────────────────────

# Publieke URL van de site (zonder slash aan het eind)
NEXT_PUBLIC_SITE_URL=https://carmendegroot.nl

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ALLEEN voor de lokale scripts (seed / create-admin). Nooit in de browser gebruiken.
# Hoeft NIET in Vercel te staan.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Optioneel: e-mailnotificatie bij nieuwe contactberichten via Resend (resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=carmen@kpnmail.nl
CONTACT_FROM_EMAIL=Website <noreply@carmendegroot.nl>
